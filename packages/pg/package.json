{
	"name": "@viktorbarzin/pg",
	"version": "0.1.0",
	"description": "Drizzle on Bun SQL: a small pool that re-reads a rotated password file, migrations under an advisory lock, a migrate CLI and throwaway test databases.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"default": "./dist/testing.js"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"engines": {
		"bun": ">=1.4.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ViktorBarzin/app-kit.git",
		"directory": "packages/pg"
	},
	"homepage": "https://github.com/ViktorBarzin/app-kit/tree/master/packages/pg#readme",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsc -b",
		"test": "bun test"
	},
	"peerDependencies": {
		"@viktorbarzin/log": "^0.1.0",
		"@viktorbarzin/runtime": "^0.1.0",
		"drizzle-orm": "^0.45.0"
	},
	"devDependencies": {
		"@viktorbarzin/log": "workspace:^",
		"@viktorbarzin/runtime": "workspace:^",
		"drizzle-orm": "^0.45.4"
	}
}
